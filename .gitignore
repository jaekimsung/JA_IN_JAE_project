# Local editor/cache state
.vscode/
__pycache__/
*.py[cod]

# Local research rollout/checkpoint outputs
/docs/research_checks/**/integration_v*/
/docs/research_checks/**/early_probe/
/docs/research_checks/**/resume_probe*/
/docs/research_checks/**/transitions.jsonl

# Stray simulator logs
MUJOCO_LOG.TXT

# Keep only the result records and logs used by dashboard/server.py.
/runs/**
!/runs/**/
!/runs/**/*.log
!/runs/**/CONFIG.json
!/runs/**/STATUS.json
!/runs/**/COMPLETE.json
!/runs/**/BEST.json
!/runs/**/curve.jsonl
!/runs/**/SAMPLE_EFFICIENCY.json
!/runs/**/SUMMARY.json
!/runs/**/EPISODES.json
!/runs/**/POOL.json

# Raw datasets, model bundles and snapshots are local, including their metadata.
/runs/**/dataset/
/runs/**/transitions/
/runs/**/shards/
/runs/**/checkpoints/
/runs/**/update-*/
/runs/**/source_snapshot/
/runs/**/__pycache__/

# Collection settings and worker status are outside the dashboard's pool view.
/runs/main_collection_*/**/CONFIG.json
/runs/main_collection_*/**/STATUS.json
